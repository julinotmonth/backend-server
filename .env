# Copy this file to `.env` and adjust for your environment.

# PostgreSQL connection string.
DATABASE_URL=postgres://reethau:reethau_dev_pw@localhost:5432/reethau_inventory

# Port the API listens on.
PORT=4000

# Secret used to sign login session tokens (JWT). Generate a real random
# value for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reethau-dev-secret-change-me
